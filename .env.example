# Supabase (frontend; also read by api/recommend.js to verify the caller's session)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Books API (optional, but recommended for higher rate limits)
VITE_GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# ── Server-side only — set these in the Vercel dashboard, NOT here ──
# GEMINI_API_KEY=            # api/recommend.js — Discovery recommendations (primary model)
# ANTHROPIC_API_KEY=         # api/recommend.js — Claude Haiku fallback when Gemini is unavailable
# HARDCOVER_API_TOKEN=       # api/book-search.js — Hardcover catalog search (primary)
# GOOGLE_BOOKS_API_KEY=      # api/book-search.js — Google Books fallback (VITE_GOOGLE_BOOKS_API_KEY also works)
